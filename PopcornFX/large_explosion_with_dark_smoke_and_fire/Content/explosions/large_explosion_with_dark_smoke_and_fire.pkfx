{
	CustomName = {
		"@eng:ai_data",
	};
	Description = {
		"@eng:effect_description: A powerful, cinematic explosion effect featuring an intense initial flash, billowing dark smoke clouds, fiery core with embers, and dramatic debris trails. Designed for impactful destruction sequences, vehicle explosions, and large-scale detonations.\\n\\nDescriptors: explosive, destructive, cinematic, intense, dramatic, fiery, smoky\\n\\ntags: explosion, fire, smoke, blast, detonation, destruction, debris, embers, shockwave, impact, large, cinematic\\n\\n---\\n\\nSuggested Presets:\\n\\n[Small Blast] (Confidence: 0.95)\\nCompact explosion for grenades, small charges, or minor impacts\\nParams: GlobalScale=0.4, InitialBlastScale=0.8, MainExplosionLifetime=1.2, MainExplosionColorIntensity=1.5\\n\\n[Medium Explosion] (Confidence: 0.95)\\nBalanced explosion for barrels, small vehicles, or standard combat impacts\\nParams: GlobalScale=1.0, InitialBlastScale=1.5, MainExplosionLifetime=2.0, MainExplosionColorIntensity=2.0\\n\\n[Massive Detonation] (Confidence: 0.92)\\nLarge-scale explosion for fuel tanks, large vehicles, or building destruction\\nParams: GlobalScale=3.0, InitialBlastScale=4.0, MainExplosionLifetime=5.0, MainExplosionColorIntensity=4.0\\n\\n[Quick Flash] (Confidence: 0.88)\\nFast, bright explosion with minimal smoke - good for energy weapons or quick detonations\\nParams: GlobalScale=0.8, InitialBlastLifetime=0.04, InitialBlastScale=2.5, MainExplosionLifetime=0.6\\n\\n[Smoky Demolition] (Confidence: 0.85)\\nHeavy smoke with subdued fire - ideal for building collapses or dirty explosions\\nParams: GlobalScale=2.0, MainExplosionColorIntensity=0.8, MainExplosionLifetime=6.0\\n\\n---\\n\\nAlternate Use Cases:\\n\\n[Magical Burst] (Confidence: 0.75)\\nAdjust: MainExplosionColorIntensity=8.0 with purple/blue color tint\\nWhy: Explosion dynamics work well for magical energy releases with color adjustments\\n\\n[Sci-Fi Plasma Detonation] (Confidence: 0.72)\\nAdjust: InitialBlastScale=3.0, MainExplosionColorIntensity=12.0 with cyan tint\\nWhy: Bright flash and billowing particles suit plasma/energy weapon impacts",
	};
	WorkspacePosition = int2(-6226, -132);
	PostItType = Blue;
	PostIt = true;
	SelfSize = int2(560, 436);
}
