CParticleNodeScript	$18012972
{
	ExecStage = Evolve;
	InputPins = {
		"$1091A6B4",
		"$59DC9C7A",
		"$7472E604",
		"$958948EE",
		"$F41007DB",
	};
	WorkspacePosition = int2(154, -308);
	Expression = "//inputs
//Pos - float3
//Rot - orientation
//Scl - float3
//Color - float4
//Enabled - bool
//vertices
float3 v1 = rotate(scene.convert(float3(-0.383, 0.924, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v0 = rotate(scene.convert(float3(0.0, 1.0, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v2 = rotate(scene.convert(float3(-0.707, 0.707, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v3 = rotate(scene.convert(float3(-0.924, 0.383, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v4 = rotate(scene.convert(float3(-1.0, 0.0, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v5 = rotate(scene.convert(float3(-0.924, -0.383, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v6 = rotate(scene.convert(float3(-0.707, -0.707, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
float3 v7 = rotate(scene.convert(float3(-0.383, -0.924, 0.0), axisSystem.RHZUP, scene.coordinateSystem()),Rot)*Scl+Pos;
