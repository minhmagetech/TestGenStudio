CParticleNodeTemplateExport	$C0A81029
{
	Description = {
		"@eng:Specifies how the billboard geometry should be build & aligned.\\nUnless mentioned otherwise, the generated geometry will be a quad: 2 triangles, 4 vertices.\\n<ul>\\n<li><b>ScreenAligned</b>: Oriented to always face the camera screen plane</li>\\n<li><b>ViewposAligned</b>: Oriented to always face the camera position</li>\\n<li><b>AxisAligned</b>: Constrained along the <c>Axis</c> vector, tries facing the screen by rotating around the axis</li>\\n<li><b>AxisAlignedSpheroid</b>: Same as <c>AxisAligned</c>, but vertices will always enclose a spheroid, preventing the billboard from looking like a thin slice when looking along the direction of <c>Axis</c></li>\\n<li><b>PlaneAligned</b>: Constrained on two axes, does not depend on the camera, will appear as a 3D plane (note that the `rotation` behave differently from regular billboards)</li>\\n</ul>\\n<b style=\'color:red;\'>The Billboard AxisAlignedSpheroid is broken at the moment</b>\\n\\nNote that the AxisAlignedCapsule is absent, it can be implemented but would require 3 renderers",
	};
	InputPins = {
		"$DEF3BA33",
	};
	OutputPins = {
		"$22E9B2B4",
	};
	WorkspacePosition = int2(1958, -154);
	ExportedName = "General.BillboardingMode";
	ExportedType = int;
	Type = Input;
	InputType = Property;
	DropDownMode = SingleSelect;
	EnumList = {
		"ScreenAligned",
		"ViewposAligned",
		"AxisAligned",
		"AxisAlignedSpheroid",
		"PlaneAligned",
	};
}
