<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions">
  <noesis:LayoutScaler ReferenceResolution="1080,1920">
    <Grid>
      <!-- Full-screen dim overlay -->
      <Border Background="#CC000008"/>

      <Grid x:Name="ContentContainer" Margin="{Binding safeAreaMargin}">
        <!-- Centered modal panel -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="920" MinHeight="700"
                Background="#E6080818" CornerRadius="18" BorderThickness="3"
                Padding="40,36">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF00E5FF" Offset="0"/>
              <GradientStop Color="#FF7B2FBE" Offset="0.5"/>
              <GradientStop Color="#FFFF2D95" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Headline -->
            <TextBlock Grid.Row="0" Text="UPGRADE YOUR REALITY"
                       FontFamily="Teko" FontSize="72" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,10,0,16">
              <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FF00E5FF" Offset="0"/>
                  <GradientStop Color="#FFFF2D95" Offset="1"/>
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>

            <!-- Invite copy -->
            <TextBlock Grid.Row="1"
                       Text="Step through the portal and unlock your full experience in the Horizon app. Exclusive rewards await!"
                       FontFamily="Teko" FontSize="48" Foreground="#CCFFFFFF"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="20,0,20,24"/>

            <!-- Spacer -->
            <Border Grid.Row="2"/>

            <!-- Not-available message (hidden by default) -->
            <TextBlock Grid.Row="3"
                       Text="Migration is not available right now."
                       FontFamily="Teko" FontSize="44"
                       Foreground="#FFFF6666"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,16"
                       Visibility="{Binding notAvailableVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Buttons row -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,20">
              <!-- LET'S GO button -->
              <Button MinWidth="360" MinHeight="110" Margin="0,0,24,0">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="14" Padding="24,16"
                            Background="#FF00CDE5" BorderThickness="2" BorderBrush="#FF00F0FF">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="LET'S GO" FontFamily="Teko" FontSize="52"
                           FontWeight="Bold" Foreground="White"/>
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="Click">
                    <b:InvokeCommandAction Command="{Binding events.letsGoClick}"/>
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </Button>

              <!-- MAYBE LATER button -->
              <Button MinWidth="360" MinHeight="110">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="14" Padding="24,16"
                            Background="#FF9B1D7A" BorderThickness="2" BorderBrush="#FFFF2D95">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Text="MAYBE LATER" FontFamily="Teko" FontSize="52"
                           FontWeight="Bold" Foreground="White"/>
                <b:Interaction.Triggers>
                  <b:EventTrigger EventName="Click">
                    <b:InvokeCommandAction Command="{Binding events.maybeLaterClick}"/>
                  </b:EventTrigger>
                </b:Interaction.Triggers>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- BooleanToVisibilityConverter resource -->
      <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      </Grid.Resources>
    </Grid>
  </noesis:LayoutScaler>
</Component>
