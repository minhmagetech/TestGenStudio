<StackPanel x:Name="SoftCurrencyRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    Margin="0,20,20,0"
    Orientation="Vertical">

    <!-- One pill per currency, bound to the ViewModel's Pills list. -->
    <ItemsControl ItemsSource="{Binding Pills}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="#CC1A1A1A"
                        CornerRadius="14"
                        Padding="14,8"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text=":  "
                                   FontSize="20"
                                   Foreground="#AAAAAA"/>
                        <TextBlock Text="{Binding Balance}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFD54A"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- DEMO ONLY: spend button. Remove (or replace with Store UI) for production. -->
    <Button x:Name="DemoSpendButton"
            Content="SPEND"
            Command="{Binding events.onSpendClicked}"
            HorizontalAlignment="Right"
            Margin="0,4,0,0"
            Padding="16,10"
            FontSize="18"
            FontWeight="Bold"
            Foreground="#FFFFFF"
            Cursor="Hand">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="SpendBorder"
                        Background="#CC3366FF"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="SpendBorder" Property="Background" Value="#AA2255DD"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</StackPanel>
