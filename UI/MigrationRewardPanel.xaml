<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions">
  <noesis:LayoutScaler ReferenceResolution="1080,1920">
    <Grid>
      <!-- Full-screen dim overlay -->
      <Border Background="#CC050208"/>

      <Grid x:Name="ContentContainer" Margin="{Binding safeAreaMargin}">
        <!-- Centered reward modal -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="880" MinHeight="620"
                CornerRadius="22" BorderThickness="4" Padding="44,40">
          <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#FF1A0F08" Offset="0"/>
              <GradientStop Color="#FF0D0806" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FFFFD700" Offset="0"/>
              <GradientStop Color="#FFDA8C00" Offset="0.5"/>
              <GradientStop Color="#FFFFD700" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- REWARD UNLOCKED label -->
            <TextBlock Grid.Row="0" Text="REWARD UNLOCKED!"
                       FontFamily="Oswald" FontSize="52" FontWeight="Bold"
                       Foreground="#FFFFD700"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,20"/>

            <!-- Diamond icon text -->
            <TextBlock Grid.Row="1" Text="100 DIAMONDS"
                       FontFamily="Anton" FontSize="96" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,16">
              <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                  <GradientStop Color="#FFFFF0B0" Offset="0"/>
                  <GradientStop Color="#FFFFD700" Offset="0.5"/>
                  <GradientStop Color="#FFDA8C00" Offset="1"/>
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>

            <!-- Body copy -->
            <TextBlock Grid.Row="2"
                       Text="Welcome to Horizon! Your 100 diamonds have been added to your wallet."
                       FontFamily="Teko" FontSize="48" Foreground="#DDFFFFFF"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Margin="20,0,20,24"/>

            <!-- Spacer -->
            <Border Grid.Row="3"/>

            <!-- Close button -->
            <Button Grid.Row="4" HorizontalAlignment="Center"
                    MinWidth="400" MinHeight="110" Margin="0,12,0,16">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border CornerRadius="14" Padding="32,18"
                          BorderThickness="2" BorderBrush="#FFFFD700">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFBF8C00" Offset="0"/>
                        <GradientStop Color="#FF8A5E00" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <TextBlock Text="Close" FontFamily="Oswald" FontSize="56"
                         FontWeight="Bold" Foreground="White"/>
              <b:Interaction.Triggers>
                <b:EventTrigger EventName="Click">
                  <b:InvokeCommandAction Command="{Binding events.closeClick}"/>
                </b:EventTrigger>
              </b:Interaction.Triggers>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Component>
