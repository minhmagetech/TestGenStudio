                            150
                        ]
                    }
                }
            ],
            "transitions": [
                {
                    "from": "Grounded",
                    "to": "Jump Start",
                    "event": "JumpTrigger",
                    "blendTimeSec": 0.05
                },
                {
                    "from": "Grounded",
                    "to": "Jump Loop",
                    "blendTimeSec": 0.15,
                    "conditions": [
                        {
                            "variable": "IsRecentlyGrounded",
                            "value": false,
                            "operation": "equal"
                        },
                        {
                            "variable": "IsJumping",
                            "value": false,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Jump Start",
                    "to": "Jump Loop",
                    "blendTimeSec": 0.05,
                    "conditions": [
                        {
                            "variable": "__state_finished",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Jump Loop",
                    "to": "Jump Land",
                    "blendTimeSec": 0.15,
                    "conditions": [
                        {
                            "variable": "IsGrounded",
                            "value": true,
                            "operation": "equal"
                        }
                    ]
                },
                {
                    "from": "Jump Land",
                    "to": "Jump Start",
                    "event": "JumpTrigger",
                    "blendTimeSec": 0.05
                },
                {
                    "from": "Jump Land",
                    "to": "Grounded",
                    "blendTimeSec": 1.5,
                    "blendEarly": false,
                    "freezeDestination": false,
                    "conditions": [
                        {
                            "variable": "Speed",
                            "value": 0.01,
                            "operation": "greater"
                        }
                    ]
                },
                {
                    "from": "Jump Land",
                    "to": "Grounded",
                    "blendTimeSec": 0.05,
                    "blendEarly": false,
                    "conditions": [
                        {
                            "variable": "__state_finished",
                            "value": true,
                            "operation": "equal"
                        },
                        {
                            "variable": "Speed",
                            "value": 0.01,
                            "operation": "lessOrEqual"
                        }
                    ]
                }
            ]
        },
